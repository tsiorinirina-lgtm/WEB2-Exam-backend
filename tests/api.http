@baseUrl = http://localhost:3001/api
@adminEmail = admin@examhub.local
@adminPassword = change-me-admin
@studentEmail = student@examhub.local
@studentPassword = change-me-student
@courseId = 1
@examId = 1
@questionId = 1
@choiceId = 1

### Health check
GET http://localhost:3001/ping

### Login as admin
# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### Login as student
# @name studentLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{studentEmail}}",
  "password": "{{studentPassword}}"
}

### Reject invalid credentials
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "wrong-password"
}

### List courses as admin
GET {{baseUrl}}/courses
Authorization: Bearer {{adminLogin.response.body.$.token}}

### Reject course access without authentication
GET {{baseUrl}}/courses

### Create a course as admin
# @name createCourse
POST {{baseUrl}}/courses
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{
  "code": "REST-01",
  "name": "REST Client Testing",
  "description": "Course created from the VS Code REST Client extension"
}

### Update a course as admin
PUT {{baseUrl}}/courses/{{courseId}}
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{
  "code": "REST-01",
  "name": "REST Client Testing Updated",
  "description": "Updated course description"
}

### List exams as admin
GET {{baseUrl}}/exams
Authorization: Bearer {{adminLogin.response.body.$.token}}

### Get one exam as admin
GET {{baseUrl}}/exams/{{examId}}
Authorization: Bearer {{adminLogin.response.body.$.token}}

### Create an exam as admin
POST {{baseUrl}}/exams
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{
  "course_id": {{courseId}},
  "title": "REST Client Exam",
  "description": "Exam used for manual API verification",
  "starts_at": "2026-01-01T00:00:00.000Z",
  "ends_at": "2099-12-31T23:59:59.000Z"
}

### List exam questions as admin
GET {{baseUrl}}/exams/{{examId}}/questions
Authorization: Bearer {{adminLogin.response.body.$.token}}

### Add a question as admin
POST {{baseUrl}}/exams/{{examId}}/questions
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{
  "statement": "Which protocol is used by REST APIs?",
  "points": 1,
  "position": 1,
  "choices": [
    { "text": "HTTP", "is_correct": true },
    { "text": "FTP", "is_correct": false }
  ]
}

### Update a question as admin
PUT {{baseUrl}}/questions/{{questionId}}
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{
  "statement": "Which protocol is commonly used by REST APIs?",
  "points": 2
}

### List students as admin
GET {{baseUrl}}/students
Authorization: Bearer {{adminLogin.response.body.$.token}}

### Student exam list
GET {{baseUrl}}/my/exams
Authorization: Bearer {{studentLogin.response.body.$.token}}

### Student exam details
GET {{baseUrl}}/my/exams/{{examId}}
Authorization: Bearer {{studentLogin.response.body.$.token}}

### Student results
GET {{baseUrl}}/my/results
Authorization: Bearer {{studentLogin.response.body.$.token}}

### Submit an exam as a student
POST {{baseUrl}}/my/exams/{{examId}}/submit
Authorization: Bearer {{studentLogin.response.body.$.token}}
Content-Type: application/json

{
  "answers": [
    {
      "question_id": {{questionId}},
      "choice_id": {{choiceId}}
    }
  ]
}

### Reject student access to admin courses
GET {{baseUrl}}/courses
Authorization: Bearer {{studentLogin.response.body.$.token}}

### Reject admin access to student exams
GET {{baseUrl}}/my/exams
Authorization: Bearer {{adminLogin.response.body.$.token}}

### Delete a question as admin
DELETE {{baseUrl}}/questions/{{questionId}}
Authorization: Bearer {{adminLogin.response.body.$.token}}

### Delete a course as admin
DELETE {{baseUrl}}/courses/{{courseId}}
Authorization: Bearer {{adminLogin.response.body.$.token}}
